{
  "name": "pocketshell-web",
  "version": "0.1.0",
  "description": "Web port of PocketShell — Google login, synced hosts, browser terminal over a Lambda SSH bridge.",
  "license": "MIT",
  "author": "Alexey Grigorev <alexey.s.grigoriev@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
