    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "marked": "^18.0.11",
    "pinia": "2.3.0",
    "ssh2": "^1.17.0",
    "tweetnacl": "^1.0.3",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
