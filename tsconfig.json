{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ui/*": ["../pocketshell-core/packages/ui/src/*"],
      "@pocketshell/core": ["../pocketshell-core/dist/esm/index.d.ts"],
      "@pocketshell/core/*": ["../pocketshell-core/dist/esm/*"],
      "@pocketshell/core": ["../pocketshell-core/dist/esm/index.d.ts"],
      "@pocketshell/core/*": ["../pocketshell-core/dist/esm/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
